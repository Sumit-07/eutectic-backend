{
  "name": "@eutectic/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint: no rules configured yet (M0-SH-01 stub)\"",
    "start": "pnpm run build && node --env-file-if-exists=../../.env dist/main.js",
    "test": "pnpm run build && node --env-file-if-exists=../../.env --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@eutectic/db": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "graphile-worker": "^0.17.3"
  },
  "devDependencies": {
    "@types/node": "^22"
  }
}
