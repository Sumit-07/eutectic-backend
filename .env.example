# Eutectic backend — local environment template.
# Copy to `.env` at this directory (eutectic-backend/) and edit as needed.
# `.env` is gitignored; this file is the only place a URL may be written down.
#
#   cp .env.example .env
#
# Values below match docker-compose.yml exactly.

# --- Postgres: database AND job queue (system-design §3, graphile-worker) ---
DATABASE_URL=postgres://eutectic:eutectic@localhost:5432/eutectic

# --- Redis: cache, counters, rate limiting only. Never the queue. ---
# Host port is 6380 because 6379 was already bound on the dev machine.
REDIS_URL=redis://localhost:6380

# --- Admin access (P-09, DIRECTIVE §3) ---
# Comma-separated `users.id` UUIDs. There is no admin role in the database and
# no UI for granting admin: the allowlist IS this variable, so granting admin is
# a deploy with a reviewer attached.
#
# UNSET OR EMPTY DENIES EVERY `/v1/admin/*` REQUEST. That is the intended
# failure mode, not an oversight — a forgotten variable must not leave the
# settings that control spend open to every logged-in user.
#
# A malformed entry is a BOOT-TIME error: the process refuses to start rather
# than silently skipping it. Ids only; a handle can be changed by its owner.
# ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111

# --- Optional: connection pool tuning. Defaults shown; unset is fine. ---
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
