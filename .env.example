# Eutectic backend — local environment template.
# Copy to `.env` at this directory (eutectic-backend/) and edit as needed.
# `.env` is gitignored; this file is the only place a URL may be written down.
#
#   cp .env.example .env
#
# Values below match docker-compose.yml exactly.

# --- Postgres: database AND job queue (system-design §3, graphile-worker) ---
DATABASE_URL=postgres://eutectic:eutectic@localhost:5432/eutectic

# --- Redis: cache, counters, rate limiting only. Never the queue. ---
# Host port is 6380 because 6379 was already bound on the dev machine.
REDIS_URL=redis://localhost:6380

# --- Optional: connection pool tuning. Defaults shown; unset is fine. ---
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
