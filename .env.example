# Eutectic backend — local environment template.
# Copy to `.env` at this directory (eutectic-backend/) and edit as needed.
# `.env` is gitignored; this file is the only place a URL may be written down.
#
#   cp .env.example .env
#
# Values below match docker-compose.yml exactly.

# --- Postgres: database AND job queue (system-design §3, graphile-worker) ---
DATABASE_URL=postgres://eutectic:eutectic@localhost:5432/eutectic

# --- Redis: cache, counters, rate limiting only. Never the queue. ---
# Host port is 6380 because 6379 was already bound on the dev machine.
REDIS_URL=redis://localhost:6380

# --- Optional: connection pool tuning. Defaults shown; unset is fine. ---
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10

# --- Inference provider selection: which API to call for model completion. ---
# INFERENCE_PROVIDER determines which provider the process will use. No default —
# silently defaulting to a real provider would let a test suite start spending money.
# Allowed values: "fake" (for testing with FakeProvider), "anthropic" (for real inference)
INFERENCE_PROVIDER=fake

# --- INFERENCE_FAKE_MODE: record or replay test fixtures (fake provider only). ---
# In "replay" mode (default), FakeProvider reads pre-recorded API responses from fixture
# files and never reaches the network. Use this for testing.
# In "record" mode, FakeProvider wraps a real Anthropic adapter, captures exchanges,
# and writes committed, human-readable fixtures. Requires ANTHROPIC_API_KEY.
# Allowed values: "record", "replay"
# Default: "replay"
# INFERENCE_FAKE_MODE=replay

# --- INFERENCE_FIXTURE_DIR: directory where FakeProvider reads/writes test fixtures (fake only). ---
# Absolute path to the directory containing fixture files (for both record and replay modes).
# Fixture files are named <provider>-<key>.json where key is a SHA256 hash of the request.
# Default: packages/inference/fixtures (relative to package root)
# INFERENCE_FIXTURE_DIR=/path/to/fixtures

# --- INFERENCE_FAKE_TARGET: which real provider to simulate in record mode (fake only). ---
# When INFERENCE_FAKE_MODE=record, INFERENCE_FAKE_TARGET specifies which provider FakeProvider
# wraps to capture real responses. Only "anthropic" is currently supported.
# Allowed values: "anthropic"
# Default: "anthropic"
# INFERENCE_FAKE_TARGET=anthropic
